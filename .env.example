# 七牛公开前缀（推荐，国内/微信可访问）
NEXT_PUBLIC_QINIU_PUBLIC_BASE=http://storage.otrue.top
# 或 R2（备用）
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-xxxx.r2.dev
# 本站根地址（EdgeOne 部署后的域名）
NEXT_PUBLIC_SHARE_WEB_BASE=https://your-project.edgeone.app
# 不填则默认用 {NEXT_PUBLIC_QINIU_PUBLIC_BASE}/app/rent_agent.apk
NEXT_PUBLIC_APP_DOWNLOAD_URL=
NEXT_PUBLIC_APP_DOWNLOAD_HINT=已安装则打开 App；未安装请下载（Android）
# 唤起已安装 App（需与 AndroidManifest 中 scheme 一致）
NEXT_PUBLIC_APP_SCHEME=yunchu
NEXT_PUBLIC_APP_PACKAGE=com.local.rent.rent_agent
