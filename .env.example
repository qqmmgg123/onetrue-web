# —— 服务端网关（EdgeOne 上配置；勿提交真实值）——
# EdgeOne 线上：真实上游 https://xxxx.supabase.co
# 本机国内开发：可改为 https://你的域名/api/sb（经已部署网关反代，避免直连 supabase.co 502）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 找 AI / 笔记内 AI（推荐配在 EdgeOne，不依赖 Supabase Functions）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 云端语音转写（可选；浏览器无 Web Speech 时用）
# 兼容 OpenAI /audio/transcriptions；不配则回退用 LLM_API_KEY + 同 base
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=
# ASR_MODEL=whisper-1

# 头像上传（七牛）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_BASE=http://storage.example.com
QINIU_UPLOAD_HOST=https://up-as0.qiniup.com

# 本站
NEXT_PUBLIC_SITE_URL=https://your-edgeone-domain
NEXT_PUBLIC_APP_DOWNLOAD_URL=
NEXT_PUBLIC_APP_DOWNLOAD_HINT=下载醍醐 App（Android）
