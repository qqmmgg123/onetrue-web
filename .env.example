# —— 服务端网关（推荐；勿提交真实值）——
# EdgeOne / 服务器上 Next 用这些变量直连 Supabase，浏览器与 App 只访问本站 /api/*
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# 可选：服务端特权（试点可不填；后续写操作可考虑）
# SUPABASE_SERVICE_ROLE_KEY=

# 兼容旧配置：未设 SUPABASE_* 时回退到 NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 本站根地址（分享 / OG）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：App 下载
NEXT_PUBLIC_APP_DOWNLOAD_URL=
NEXT_PUBLIC_APP_DOWNLOAD_HINT=下载醍醐 App（Android）
